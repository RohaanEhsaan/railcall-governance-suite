{
  "$schema": "https://railcall.ai/schemas/module-v1.json",
  "id": "rohan/linear-governance-hub",
  "name": "linear-governance-hub",
  "version": "1.3.2",
  "title": "Linear Governance Hub",
  "description": "Enterprise triage & issue orchestration with anti-drift state locks and escalation guards. contest:round2",
  "publisher_pubkey": "4ded0aa74bbcfe3ede9202b96e78819d1703b4fdcce7915c07ae06734a5661d0",
  "secrets": [
    {
      "name": "LINEAR_API_KEY",
      "label": "Linear Personal Access Token (lin_api_...)"
    }
  ],
  "commands": [
    {
      "id": "linear.verify_connection",
      "name": "verify_connection",
      "title": "Verify Linear Auth & Quota",
      "description": "Preflight inspection of workspace viewer identity, team scopes, and API quota.",
      "inputs": {},
      "input_schema": {},
      "requires": [
        "LINEAR_API_KEY"
      ],
      "provider": "linear"
    },
    {
      "id": "linear.transition_status",
      "name": "transition_status",
      "title": "Transition Status (Anti-Drift)",
      "description": "Binds state transition to an SHA-256 issue fingerprint; halts if updated mid-review.",
      "inputs": {
        "issueId": {
          "type": "string",
          "label": "Issue ID (UUID or Key)",
          "required": true,
          "help": "Issue ID (UUID or Key)"
        },
        "stateId": {
          "type": "string",
          "label": "Target State UUID",
          "required": true,
          "help": "Target State UUID"
        },
        "expected_fingerprint": {
          "type": "string",
          "label": "Expected State Fingerprint (SHA-256)",
          "required": false,
          "help": "Cryptographic anti-drift fingerprint from get_issue or preview."
        }
      },
      "input_schema": {
        "issueId": {
          "type": "string",
          "label": "Issue ID (UUID or Key)",
          "required": true,
          "help": "Issue ID (UUID or Key)"
        },
        "stateId": {
          "type": "string",
          "label": "Target State UUID",
          "required": true,
          "help": "Target State UUID"
        },
        "expected_fingerprint": {
          "type": "string",
          "label": "Expected State Fingerprint (SHA-256)",
          "required": false,
          "help": "Cryptographic anti-drift fingerprint from get_issue or preview."
        }
      },
      "requires": [
        "LINEAR_API_KEY"
      ],
      "provider": "linear"
    },
