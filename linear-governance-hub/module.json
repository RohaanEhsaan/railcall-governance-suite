        "issueId": {
          "type": "string",
          "label": "Issue ID",
          "required": true,
          "help": "Issue ID"
        },
        "priority": {
          "type": "string",
          "label": "Priority (0=None, 1=Urgent, 2=High, 3=Med, 4=Low)",
          "required": true,
          "help": "Priority (0=None, 1=Urgent, 2=High, 3=Med, 4=Low)"
        },
        "allow_urgent": {
          "type": "string",
          "label": "Explicit Urgent P0/P1 Escalation Override",
          "default": false,
          "help": "Explicit Urgent P0/P1 Escalation Override"
        },
        "expected_fingerprint": {
          "type": "string",
          "label": "Expected State Fingerprint (SHA-256)",
          "required": false,
          "help": "Cryptographic anti-drift fingerprint from get_issue or preview."
        }
      },
      "input_schema": {
        "issueId": {
          "type": "string",
          "label": "Issue ID",
          "required": true,
          "help": "Issue ID"
        },
        "priority": {
          "type": "string",
          "label": "Priority (0=None, 1=Urgent, 2=High, 3=Med, 4=Low)",
