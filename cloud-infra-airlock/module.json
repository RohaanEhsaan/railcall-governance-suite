{
  "module": "rohan/cloud-infra-airlock",
  "version": "1.5.0",
  "title": "Cloud Infrastructure Cost & Kill-Switch Airlock",
  "description": "Zero-trust governance for AWS infrastructure, enforcing spend ceilings, strict GPU quarantines, and instance safety locks.",
  "category": "cloud",
  "author": "Rohan Ehsaan",
  "runtime": "python",
  "entrypoint": "handlers/handler.py",
  "policy": {
    "network": [
      "127.0.0.1:4566",
      "localhost:4566",
      "*.amazonaws.com"
    ],
    "filesystem_writes": false,
    "subprocess": false
  },
  "secrets": [
    "AWS_ACCESS_KEY_ID",
    "AWS_SECRET_ACCESS_KEY",
    "AWS_REGION",
    "AWS_ENDPOINT_URL"
  ],
  "commands": {
    "aws.inspect_running_spend": {
      "mode": "read",
      "impact_tier": "READ_ONLY",
      "provider": "aws",
      "requires": [
        "AWS_ACCESS_KEY_ID",
        "AWS_SECRET_ACCESS_KEY"
      ],
      "description": "Paginates running EC2 instances and computes active burn rate estimates.",
      "input_schema": {
        "type": "object",
        "properties": {
          "region": {
            "type": "string",
            "default": "us-east-1"
          }
        }
      }
    },
    "aws.preview_instance_launch": {
      "mode": "read",
      "impact_tier": "READ_ONLY",
      "provider": "aws",
      "requires": [],
      "description": "Deterministic offline cost preview and GPU hardware detection without credentials.",
      "input_schema": {
        "type": "object",
        "properties": {
          "instance_type": {
            "type": "string",
            "default": "t3.micro"
          }
        },
        "required": [
          "instance_type"
        ]
      }
    },
    "aws.provision_instance": {
      "mode": "write_requires_approval",
      "impact_tier": "HIGH",
      "provider": "aws",
      "requires": [
        "AWS_ACCESS_KEY_ID",
        "AWS_SECRET_ACCESS_KEY"
      ],
      "description": "Provisions an EC2 instance with governance tags; blocks GPUs and enforces spend ceilings.",
      "input_schema": {
        "type": "object",
        "properties": {
          "instance_type": {
            "type": "string"
          },
          "image_id": {
            "type": "string"
          },
          "override_ceiling": {
            "type": "string",
            "default": "false"
          },
          "region": {
            "type": "string",
            "default": "us-east-1"
          }
        },
        "required": [
          "instance_type",
          "image_id"
        ]
      }
    },
    "aws.quarantine_orphan_disks": {
      "mode": "write_requires_approval",
      "impact_tier": "MEDIUM",
      "provider": "aws",
      "requires": [
        "AWS_ACCESS_KEY_ID",
        "AWS_SECRET_ACCESS_KEY"
      ],
      "description": "Finds unattached EBS volumes and applies GovernanceQuarantine tags.",
      "input_schema": {
        "type": "object",
        "properties": {
          "tag_quarantine": {
            "type": "string",
            "default": "true"
          },
          "region": {
            "type": "string",
            "default": "us-east-1"
          }
        }
      }
    },
    "aws.emergency_killswitch": {
      "mode": "write_requires_approval",
      "impact_tier": "HIGH",
      "provider": "aws",
      "requires": [
        "AWS_ACCESS_KEY_ID",
        "AWS_SECRET_ACCESS_KEY"
      ],
      "description": "Terminates agent-governed instances; refuses unmanaged instances unless force=true.",
      "input_schema": {
        "type": "object",
        "properties": {
          "instance_id": {
            "type": "string"
          },
          "force": {
            "type": "string",
            "default": "false"
          },
          "region": {
            "type": "string",
            "default": "us-east-1"
          }
        },
        "required": [
          "instance_id"
        ]
      }
    },
    "aws.verify_immutable_db_lock": {
      "mode": "read",
      "impact_tier": "READ_ONLY",
      "provider": "aws",
      "requires": [
        "AWS_ACCESS_KEY_ID",
        "AWS_SECRET_ACCESS_KEY"
      ],
      "description": "Audits RDS instances to verify deletion protection is enabled.",
      "input_schema": {
        "type": "object",
        "properties": {
          "db_identifier": {
            "type": "string"
          },
          "region": {
            "type": "string",
            "default": "us-east-1"
          }
        },
        "required": [
          "db_identifier"
        ]
      }
    }
  },
  "manifest_version": 2,
  "publisher_pubkey": "4ded0aa74bbcfe3ede9202b96e78819d1703b4fdcce7915c07ae06734a5661d0"
}
