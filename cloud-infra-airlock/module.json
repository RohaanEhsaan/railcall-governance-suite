{
  "$schema": "https://railcall.ai/schemas/module-v1.json",
  "id": "rohan/cloud-infra-airlock",
  "name": "cloud-infra-airlock",
  "version": "1.5.0",
  "title": "Cloud Infrastructure Cost & Kill-Switch Airlock",
  "description": "Enterprise-grade AWS infrastructure airlock enforcing spend ceilings, strict GPU quarantines, and instance safety locks. contest:round2",
  "publisher_pubkey": "4ded0aa74bbcfe3ede9202b96e78819d1703b4fdcce7915c07ae06734a5661d0",
  "author": "rohan",
  "category": "Eng",
  "entrypoint": "handlers/handler.py",
  "policy": {
    "network": [
      "127.0.0.1:4566",
      "localhost:4566",
      "*.amazonaws.com"
    ],
    "filesystem_writes": false,
    "subprocess": false
  },
  "secrets": [
    {
      "name": "AWS_ACCESS_KEY_ID",
      "label": "AWS Access Key ID (AKIA...)"
    },
    {
      "name": "AWS_SECRET_ACCESS_KEY",
      "label": "AWS Secret Access Key"
    },
    {
      "name": "AWS_REGION",
      "label": "AWS Region (e.g. us-east-1)"
    },
    {
      "name": "AWS_ENDPOINT_URL",
      "label": "AWS Custom / LocalStack Endpoint URL"
    }
  ],
  "commands": [
    {
      "id": "aws.inspect_running_spend",
      "name": "aws.inspect_running_spend",
      "title": "Inspect Running Spend",
      "description": "Paginates running EC2 instances and computes active burn rate estimates.",
      "mode": "read",
      "impact_tier": "READ_ONLY",
      "provider": "aws",
      "requires": [
        "AWS_ACCESS_KEY_ID",
        "AWS_SECRET_ACCESS_KEY"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "region": {
            "type": "string",
            "default": "us-east-1"
          }
        }
      }
    },
    {
      "id": "aws.preview_instance_launch",
      "name": "aws.preview_instance_launch",
      "title": "Preview Instance Launch Cost",
      "description": "Deterministic offline cost preview and GPU hardware detection without credentials.",
      "mode": "read",
      "impact_tier": "READ_ONLY",
      "provider": "aws",
      "requires": [],
      "input_schema": {
        "type": "object",
        "properties": {
          "instance_type": {
            "type": "string",
            "default": "t3.micro"
          }
        },
        "required": [
          "instance_type"
        ]
      }
    },
    {
      "id": "aws.provision_instance",
      "name": "aws.provision_instance",
      "title": "Provision Governed EC2 Instance",
      "description": "Provisions an EC2 instance with governance tags; blocks GPUs and enforces spend ceilings.",
      "mode": "write_requires_approval",
      "impact_tier": "HIGH",
      "provider": "aws",
      "requires": [
        "AWS_ACCESS_KEY_ID",
        "AWS_SECRET_ACCESS_KEY"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "instance_type": {
            "type": "string"
          },
          "image_id": {
            "type": "string"
          },
          "override_ceiling": {
            "type": "string",
            "default": "false"
          },
          "region": {
            "type": "string",
            "default": "us-east-1"
          }
        },
        "required": [
          "instance_type",
          "image_id"
        ]
      }
    },
    {
      "id": "aws.quarantine_orphan_disks",
      "name": "aws.quarantine_orphan_disks",
      "title": "Quarantine Orphan Disks",
      "description": "Finds unattached EBS volumes and applies GovernanceQuarantine tags.",
      "mode": "write_requires_approval",
      "impact_tier": "MEDIUM",
      "provider": "aws",
      "requires": [
        "AWS_ACCESS_KEY_ID",
        "AWS_SECRET_ACCESS_KEY"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "tag_quarantine": {
            "type": "string",
            "default": "true"
          },
          "region": {
            "type": "string",
            "default": "us-east-1"
          }
        }
      }
    },
    {
      "id": "aws.emergency_killswitch",
      "name": "aws.emergency_killswitch",
      "title": "Emergency Killswitch",
      "description": "Terminates agent-governed instances; refuses unmanaged instances unless force=true.",
      "mode": "write_requires_approval",
      "impact_tier": "HIGH",
      "provider": "aws",
      "requires": [
        "AWS_ACCESS_KEY_ID",
        "AWS_SECRET_ACCESS_KEY"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "instance_id": {
            "type": "string"
          },
          "force": {
            "type": "string",
            "default": "false"
          },
          "region": {
            "type": "string",
            "default": "us-east-1"
          }
        },
        "required": [
          "instance_id"
        ]
      }
    },
    {
      "id": "aws.verify_immutable_db_lock",
      "name": "aws.verify_immutable_db_lock",
      "title": "Verify RDS Deletion Protection",
      "description": "Audits RDS instances to verify deletion protection is enabled.",
      "mode": "read",
      "impact_tier": "READ_ONLY",
      "provider": "aws",
      "requires": [
        "AWS_ACCESS_KEY_ID",
        "AWS_SECRET_ACCESS_KEY"
      ],
      "input_schema": {
        "type": "object",
        "properties": {
          "db_identifier": {
            "type": "string"
          },
          "region": {
            "type": "string",
            "default": "us-east-1"
          }
        },
        "required": [
          "db_identifier"
        ]
      }
    }
  ],
  "manifest_version": 2
}
