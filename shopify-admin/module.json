{
  "name": "shopify-admin",
  "version": "1.2.22",
  "category": "Finance",
  "author": "Rohan",
  "description": "Autonomous governance airlock for Shopify Admin REST API featuring anti-drift state locks, stock floor protection, and deterministic preflight previews. contest:round2",
  "secrets": [
    {
      "name": "SHOPIFY_SHOP_DOMAIN",
      "label": "Shopify Store Domain (your-store.myshopify.com)"
    },
    {
      "name": "SHOPIFY_ACCESS_TOKEN",
      "label": "Shopify Admin API Access Token (shpat_...)"
    }
  ],
  "commands": [
    {
      "id": "shopify.verify_shopify_connection",
      "name": "verify_shopify_connection",
      "title": "Verify Shopify Connection",
      "description": "Probes Shopify shop metadata, currency, rate limit status, and airlock operational health.",
      "inputs": {},
      "input_schema": {},
      "requires": [
        "SHOPIFY_SHOP_DOMAIN",
        "SHOPIFY_ACCESS_TOKEN"
      ],
      "provider": "shopify"
    },
    {
      "id": "shopify.get_order",
      "name": "get_order",
      "title": "Inspect Order Details",
      "description": "Extracts detailed order status, financial status, fulfillment state, and line item counts.",
      "inputs": {
        "order_id": {
          "type": "string",
          "label": "Order ID",
          "required": true,
          "help": "Order ID"
        }
      },
      "input_schema": {
        "order_id": {
          "type": "string",
          "label": "Order ID",
          "required": true,
          "help": "Order ID"
        }
      },
      "requires": [
        "SHOPIFY_SHOP_DOMAIN",
        "SHOPIFY_ACCESS_TOKEN"
      ],
      "provider": "shopify"
    },
    {
      "id": "shopify.list_orders",
      "name": "list_orders",
      "title": "List Store Orders",
      "description": "Query recent orders filtered by status for pre-mutation discovery.",
      "inputs": {
        "status": {
          "type": "string",
          "label": "Order Status (open, closed, any)",
          "default": "any",
          "help": "Order Status (open, closed, any)"
        },
        "limit": {
          "type": "string",
          "label": "Max Orders",
          "default": 10,
          "help": "Max Orders"
        }
      },
      "input_schema": {
        "status": {
          "type": "string",
          "label": "Order Status (open, closed, any)",
          "default": "any",
          "help": "Order Status (open, closed, any)"
