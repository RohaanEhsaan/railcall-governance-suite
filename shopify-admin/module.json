      "inputs": {
        "order_id": {
          "type": "string",
          "label": "Order ID",
          "required": true,
          "help": "Order ID"
        },
        "tags": {
          "type": "string",
          "label": "Tags to Append (comma-separated)",
          "required": true,
          "help": "Tags to Append (comma-separated)"
        },
        "expected_fingerprint": {
          "type": "string",
          "label": "Expected State Fingerprint (SHA-256)",
          "required": false,
          "help": "Cryptographic anti-drift fingerprint from get_order."
