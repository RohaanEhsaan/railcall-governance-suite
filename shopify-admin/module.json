        "limit": {
          "type": "string",
          "label": "Max Orders",
          "default": 10,
          "help": "Max Orders"
        }
      },
      "requires": [
        "SHOPIFY_SHOP_DOMAIN",
        "SHOPIFY_ACCESS_TOKEN"
      ],
      "provider": "shopify"
    },
