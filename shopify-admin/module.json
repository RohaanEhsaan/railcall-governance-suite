      "title": "Create Order Refund (Drift-Guarded)",
      "description": "Processes order refund with SHA-256 financial state fingerprinting and preflight verification.",
      "inputs": {
        "order_id": {
          "type": "string",
          "label": "Order ID",
          "required": true,
          "help": "Order ID"
        },
        "amount": {
          "type": "string",
          "label": "Refund Amount",
          "required": true,
          "help": "Refund Amount"
        },
        "reason": {
          "type": "string",
          "label": "Refund Reason Note",
          "default": "Customer return / Airlock-authorized",
          "help": "Refund Reason Note"
        },
        "allow_high_refund": {
          "type": "string",
          "label": "Allow High Refund (> $100)",
          "required": false,
          "help": "Set to 'true' to authorize refunds over the safety ceiling."
        }
      },
      "input_schema": {
        "order_id": {
          "type": "string",
          "label": "Order ID",
          "required": true,
          "help": "Order ID"
        },
        "amount": {
          "type": "string",
          "label": "Refund Amount",
          "required": true,
          "help": "Refund Amount"
        },
